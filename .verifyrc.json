{
  "security": {
    "secrets": true,
    "sensitiveFiles": true,
    "dangerousPatterns": true
  },
  "quality": {
    "tests": {
      "enabled": true,
      "command": ["pnpm", "test"]
    },
    "lint": {
      "enabled": false,
      "command": ["pnpm", "lint"]
    },
    "typecheck": {
      "enabled": false,
      "command": ["pnpm", "exec", "tsc", "--noEmit"]
    }
  },
  "protectedPaths": [
    ".env",
    ".github/workflows/**"
  ],
  "approval": {
    "requireForProtectedFiles": true
  },
  "execution": {
    "timeoutMs": 120000,
    "maxOutputBytes": 1048576,
    "allowedCommands": [
        ["pnpm"]
    ]
  }
}
