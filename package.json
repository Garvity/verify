{
  "name": "verify",
  "version": "1.0.0",
  "description": "Deterministic verification, MCP tooling, and model evaluation for AI coding agents.",
  "main": "./dist/cli/index.js",
  "files": [
    "dist/**",
    "benchmarks/tasks/**",
    "benchmarks/fixtures/**",
    "benchmarks/hidden-tests/**",
    "README.md",
    "screenshots/**",
    "docs/**",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli/index.js",
    "test": "vitest run tests/unit tests/integration tests/adversarial",
    "test:e2e": "vitest run tests/e2e",
    "test:security": "vitest run tests/adversarial",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit tests/integration tests/adversarial --coverage",
    "mcp": "node dist/mcp/main.js",
    "mcp:dev": "tsx src/mcp/main.ts",
    "test:mcp": "vitest run tests/integration/mcp",
    "gateway:check": "tsx src/ai/gateway/test.ts",
    "http": "node dist/http/main.js",
    "http:dev": "tsx src/http/main.ts",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  },
  "keywords": ["ai-agents", "verification", "mcp", "security", "benchmark"],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "bin": {
    "verify": "./dist/cli/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.15.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
